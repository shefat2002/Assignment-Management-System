# Database
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=AssignmentSystemDb;Username=postgres;Password=123456789

# JWT
JWT_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ISSUER=AssignmentSystemApi
JWT_AUDIENCE=AssignmentSystemFrontend

# Postgres for Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789
POSTGRES_DB=AssignmentSystemDb

NEXT_PUBLIC_API_URL=http://localhost:5000/api

